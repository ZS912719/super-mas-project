# Temporary PDF previews and downloaded rendering tools
/tmp/

# Real email corpora contain personal data and must never be committed.
# Keep downloaded Enron data and personal mail only under these ignored folders.
/benchmark/data/enron/
/benchmark/data/enron-raw/
/benchmark/data/enron-validate/
/benchmark/data/personal/
/benchmark/private/
# Downloaded corpus archives must never be committed, wherever they land.
*.tar.gz
enron_mail_*.tar.gz

# Java build outputs
/target/
/build/
/.gradle/
*.class

# Local development settings and credentials
/.idea/
/.vscode/
*.iml
.env
.env.*
!.env.example

# Local runtime data and logs
*.log
*.db
*.db-shm
*.db-wal

# Operating system metadata
.DS_Store
Thumbs.db

# Mailbox application dependencies and generated assets
/mailbox/node_modules/
/mailbox/public/
/mailbox/dist/

# Private project progress notes
/.project-progress.local.md
/runtime/

# Local development context and Obsidian workspace
/super-mas-dev-vault/

# Team vault local editor settings and retrieval caches
/super-mas-team-dev-vault/.obsidian/
/super-mas-team-dev-vault/.trash/
/super-mas-team-dev-vault/.rag-cache/

# Copyrighted papers of the bibliography: kept locally, cited in docs/references/README.md
/docs/references/bibliography/*.pdf

# Python bytecode (labelling scripts)
__pycache__/
