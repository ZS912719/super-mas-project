@startuml
title SuperMAS Email Assistant — Receive, Route, Generate and Review
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 210
hide footbox
autonumber

actor User as user
boundary "User interface" as ui
control "RoutingAgent" as router
participant "Selected\nSpecializedAgent" as agent
participant "ContextProvider" as context
database "ConversationMemory" as memory
participant "LocalLlmClient\n(local inference)" as llm
control "ReviewService" as review
participant "EmailGateway" as gateway

group Receive and select
  gateway -> ui : received email
  ui -> router : handle(email)
  router -> memory : recordReceived(email)
  router -> router : RoutingStrategy.select(email, registry)
  note over router
    Use sender, role, subject, body and thread metadata.
    Several matches: ranked score + configured tie-break.
    Low confidence / no match: select GenericAgent.
    Record selected agent, candidates and reason.
  end note
  router -> ui : show selected agent and routing reason
end

group Generate initial proposal
  router -> agent : generate(email, no feedback)
  agent -> context : loadAllowed(email, agentConfig)
  context --> agent : authorized context + source IDs
  agent -> memory : loadAllowedHistory(threadId, agentId)
  memory --> agent : allowed previous emails / drafts / sent replies
  agent -> agent : assemble prompt, email and context\napply context budget
  agent -> llm : generate(systemPrompt, contextBundle)
  llm --> agent : generated text or failure
  break Local model unavailable / generation failed
    agent --> router : generation error
    router --> ui : show recoverable error; allow retry
    ui --> user : no draft available; nothing sent
  end
  agent --> router : DraftReply
  router -> review : propose(draft)
  review -> review : DraftRepository.save(PENDING)
  review -> memory : recordDraft(draft)
  review --> ui : present proposal for review
end

loop User rejects and requests another proposal
  user -> ui : reject draft; provide comments
  ui -> review : reject(draftId, feedback)
  review -> review : persist REJECTED revision
  review -> memory : recordFeedback(draftId, feedback)
  review -> router : regenerate(draftId, feedback)
  router -> agent : generate(original email, feedback)
  agent -> context : refresh allowed context
  context --> agent : authorized context
  agent -> memory : loadAllowedHistory(threadId, agentId)
  memory --> agent : allowed history and review feedback
  agent -> agent : assemble revised prompt within budget
  agent -> llm : generate(systemPrompt, revised contextBundle)
  llm --> agent : generated text or failure
  alt Successful regeneration
    agent --> router : revised DraftReply
    router --> review : revised draft
    review -> review : persist new PENDING revision
    review -> memory : recordDraft(revised draft)
    review --> ui : show new proposal
  else Regeneration failed
    agent --> router : generation error
    router --> review : failure
    review --> ui : show error; keep rejected status; allow retry
  end
end

alt User accepts or edits, then explicitly approves a pending draft
  user -> ui : approve final text (possibly edited)
  ui -> review : approveAndSend(draftId, finalText)
  review -> review : check current PENDING revision\npersist APPROVED final text
  review -> gateway : sendApproved(email with approved finalText)
  alt Gateway confirms successful send
    gateway --> review : sent email / message ID
    review -> memory : recordSent(actual sent email)
    review -> review : persist SENT status
    review --> ui : show sent confirmation
  else Send fails
    gateway --> review : send error
    review -> review : persist SEND_FAILED (not SENT)
    review --> ui : show failure; await explicit retry
  end
else User leaves the proposal pending or cancels
  user -> ui : leave pending / cancel
  ui -> review : retain PENDING / mark CANCELLED
  note over review, gateway
    No send without explicit approval.
    Generated drafts and actual sent emails remain distinct.
  end note
end
@enduml
