@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45
hide empty members

title SuperMAS - Core Domain Data Contracts
top to bottom direction
package "Identity and input" {
class Scope <<record>> {
  +projectId: String
  +threadId: String
}
class BoardId <<record>> {
  +scope: Scope
  +taskId: String
}
class Email <<record>> {
  +id: String
  +scope: Scope
  +sender: String
  +recipients: List<String>
  +subject: String
  +body: String
  +receivedAt: Instant
  +metadata: Map<String, String>
}
class Analysis <<record>> {
  +keywords: List<String>
  +initialTags: List<String>
  +metadata: Map<String, String>
}
}
package "Shared evidence" {
class Provenance <<record>> {
  +sourceId: String
  +description: String
  +recordedAt: Instant
}
class Evidence <<record>> {
  +id: String
  +scope: Scope
  +kind: EvidenceKind
  +provenance: Provenance
  +text: String
  +permittedAgentIds: Set<String>
}
}
package "Task snapshot" {
class BlackboardSnapshot <<record>> {
  +id: BoardId
  +email: Email
  +analysis: Analysis
  +evidence: List<Evidence>
  +tasks: List<Task>
  +executions: List<ExecutionRecord>
  +drafts: List<Draft>
  +feedback: List<Feedback>
  +routing: Optional<RoutingDecision>
  +status: BoardStatus
  +budgetUsage: BudgetUsage
  +failure: Optional<Failure>
}
class Task <<record>> {
  +id: String
  +boardId: BoardId
  +action: Action
  +agentId: Optional<String>
  +status: TaskStatus
  +reason: String
}
class ExecutionRecord <<record>> {
  +taskId: String
  +selectionReason: String
  +status: TaskStatus
  +startedAt: Instant
  +finishedAt: Instant
  +summary: String
  +failure: Optional<Failure>
}
class BudgetUsage <<record>> {
  +rounds: int
  +retries: int
  +generationAttempts: int
}
class Failure <<record>> {
  +kind: FailureKind
  +message: String
  +retryable: boolean
}
}
package "Draft and review" {
class Draft <<record>> {
  +version: int
  +subject: String
  +body: String
  +agentId: String
  +explanation: String
  +origin: DraftOrigin
  +review: ReviewStatus
  +createdAt: Instant
}
class DraftProposal <<record>> {
  +subject: String
  +body: String
  +agentId: String
  +explanation: String
}
class Feedback <<record>> {
  +draftVersion: int
  +text: String
  +createdAt: Instant
}
class Approval <<record>> {
  +boardId: BoardId
  +draftVersion: int
  +approvedAt: Instant
}
}
BoardId --> "1" Scope : scope
Email --> "1" Scope : scope
BlackboardSnapshot --> "1" BoardId : id
BlackboardSnapshot --> "1" Email : email
BlackboardSnapshot --> "1" Analysis : analysis
BlackboardSnapshot --> "0..*" Evidence : evidence
BlackboardSnapshot --> "0..*" Task : tasks
BlackboardSnapshot --> "0..*" ExecutionRecord : executions
BlackboardSnapshot --> "0..*" Draft : drafts
BlackboardSnapshot --> "0..*" Feedback : feedback
BlackboardSnapshot --> "1" BudgetUsage : budgetUsage
BlackboardSnapshot --> "0..1" Failure : failure
Evidence --> "1" Provenance : provenance
Approval --> "1" BoardId : boardId
note bottom of Draft
Explanation is internal UI metadata.
Subject and body are outward reply data.
end note
note bottom of Approval
Version-specific approval is not send confirmation.
end note
legend bottom left
Selected core records nested inside org.supermas.model.Domain.
All displayed fields come from Java record components. Relationships are field references.
Supporting routing, context and model records/enums remain in Domain.java.
Shapes and multiplicities express API intent; validation is not implemented.
endlegend
@enduml
