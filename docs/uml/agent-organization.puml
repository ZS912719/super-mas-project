@startuml
!pragma layout smetana
title SuperMAS Email Assistant — Agent Organization and Context Boundaries
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50

actor "User\nfinal approval" as user
component "User interface\nagent settings + draft review" as ui #FFF7ED
component "EmailGateway\nmock / mailbox adapter" as gateway #FFF7ED
component "ReviewService\napproval, editing, rejection" as review #FFF7ED

rectangle "Local multi-agent framework" #F8FAFC {
  component "RoutingAgent\ncoordinate and delegate" as router #C7D2FE
  component "AgentRegistry\nconfigured agent instances" as registry #EEF2FF
  component "RoutingStrategy\nranking + fallback + reason" as strategy #EEF2FF

  together {
    component "StudentAgent\nstudent-specific prompt" as student #DBEAFE
    component "TeacherAgent\ncolleague-specific prompt" as teacher #DBEAFE
    component "AdministrationAgent\nadministrative prompt" as admin #DBEAFE
    component "ResearchProjectAgent\nSuperMASProject prompt" as research #DBEAFE
    component "GenericAgent\ngeneral prompt / fallback" as generic #DBEAFE
  }

  rectangle "Selected agent execution\nassemble context and generate" as execution #DBEAFE
  component "ContextProvider\nsource permissions + selection" as context #D1FAE5
  database "ConversationMemory\nreceived / generated / actual sent\nthread + agent scope" as memory #D1FAE5
  component "LocalLlmClient\nreplaceable inference adapter" as llm #D1FAE5

  together {
    folder "Student sources\ncourse rules / FAQs" as studentCtx #EFF6FF
    folder "Teacher sources\nteaching / collaboration" as teacherCtx #EFF6FF
    folder "Administration sources\nprocedures / templates" as adminCtx #EFF6FF
    folder "Project sources\nobjectives / tasks / deadlines" as researchCtx #EFF6FF
    folder "Generic sources\nexplicitly shared preferences" as genericCtx #EFF6FF
  }
}

node "Local inference engine\ne.g. Ollama + local model" as engine #ECFDF5

user --> ui : review / configure
gateway --> ui : received email
ui --> router : process email
router --> strategy : select
router --> registry : resolve
router --> student : selected request
router --> teacher : selected request
router --> admin : selected request
router --> research : selected request
router --> generic : fallback request
student --> execution
teacher --> execution
admin --> execution
research --> execution
generic --> execution
execution --> context : authorized sources
execution --> memory : allowed thread history
execution --> llm : prompt + bounded context
context --> studentCtx : allowlist
context --> teacherCtx : allowlist
context --> adminCtx : allowlist
context --> researchCtx : allowlist
context --> genericCtx : allowlist
llm --> engine : local generation only
router --> review : generated draft returned by selected agent
review --> ui : proposal / revised proposal
review --> router : reject + feedback → regenerate
review --> gateway : approved final text only
review --> memory : drafts / feedback / actual sent mail

note bottom of context
  Provider is shared infrastructure, not a shared knowledge pool.
  Each request carries agentId + permitted source IDs.
  Execution box describes selected-agent behavior, not an extra agent.
  Selected agent assembles bounded context and invokes LocalLlmClient.
end note
legend bottom
  Blue: specialized agents (separate configured instances).
  Purple: routing and organization. Green: local context / memory / inference.
  Orange: human review and mail boundary.
  Roles and source sets are illustrative; agents may be added through configuration.
  Optional critic, RAG and additional agents are outside the proposed baseline.
endlegend
@enduml
