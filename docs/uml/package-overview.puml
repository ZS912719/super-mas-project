@startuml
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45
hide empty members

title SuperMAS - Current Java Package Dependencies
left to right direction
hide members
package "org.supermas.agent" as agent {
class "AdministrationAgent\nAgentRegistry\nGenericAgent\nResearchProjectAgent\nSpecializedAgent\nStudentAgent\nTeacherAgent" as agent_contents <<source files>>
}
package "org.supermas.blackboard" as blackboard {
class "AgentBlackboard\nBlackboard\nBlackboardFactory\nBlackboardView\nPreprocessor" as blackboard_contents <<source files>>
}
package "org.supermas.context" as context {
class "ContextRetriever\nContextSelector" as context_contents <<source files>>
}
package "org.supermas.coordinator" as coordinator {
class "CoordinationStrategy\nCoordinator\nRoutingStrategy" as coordinator_contents <<source files>>
}
package "org.supermas.llm" as llm {
class "GenerationService\nLocalLlm" as llm_contents <<source files>>
}
package "org.supermas.model" as model {
class "Domain" as model_contents <<source files>>
}
package "org.supermas.persistence" as persistence {
class "AgentConfigRepository\nBlackboardRepository\nConversationRepository" as persistence_contents <<source files>>
}
package "org.supermas.review" as review {
class "DraftReviewService" as review_contents <<source files>>
}
agent ..> blackboard : imports
agent ..> model : imports
blackboard ..> model : imports
context ..> blackboard : imports
context ..> model : imports
coordinator ..> blackboard : imports
coordinator ..> model : imports
llm ..> blackboard : imports
llm ..> model : imports
persistence ..> model : imports
review ..> model : imports
legend bottom left
Arrows reflect imports present in Java source files.
Each source-file list is a package inventory, not a Java class.
Domain contains nested records and enums. No runtime wiring is implied.
endlegend
@enduml
