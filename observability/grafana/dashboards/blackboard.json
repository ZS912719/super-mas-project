        "defaults": {
          "custom": {},
          "displayName": "${__field.labels.agent}",
          "mappings": [
            {
              "type": "value",
              "options": {
                "RUNNING": {
                  "text": "RUNNING",
                  "color": "blue",
                  "index": 0
                },
                "PENDING": {
                  "text": "PENDING",
                  "color": "yellow",
                  "index": 1
                },
                "OVERLAPPING_RECORDS": {
                  "text": "OVERLAPPING_RECORDS",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
