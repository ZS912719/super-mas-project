PORT=4317
# Optional source desktop configuration. Release users receive these public IDs in the executable.
GOOGLE_DESKTOP_CLIENT_ID=
MICROSOFT_DESKTOP_CLIENT_ID=
# Legacy development Web clients: register exactly http://127.0.0.1:4317/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Ollama must listen locally. No email is sent to a remote inference service.
LOCAL_MODEL_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.2
# Optional, prototype branch: let the Java agents write drafts instead of Ollama.
# Start the agent service with the same token (see docs/plans/agent-service-api.md).
# AGENT_SERVICE_URL=http://127.0.0.1:4318
# AGENT_SERVICE_TOKEN=
# Enable request-scoped Java drafting for live mail with a local or template model.
# AGENT_SERVICE_LIVE_MAIL=yes
# The agent service's own model is set where the service starts, not here (docs/plans/llm-setup.md).
# Its online development stand-in sends email text to OpenRouter and needs SUPERMAS_LLM_ONLINE_MAIL=yes there.
